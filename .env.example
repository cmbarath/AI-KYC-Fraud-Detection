# Vercel backend environment
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[DATABASE_PASSWORD]@[POOLER_HOST]:6543/postgres
DATABASE_SSL_MODE=require
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=[BACKEND_ONLY_SUPABASE_SECRET_KEY]
SUPABASE_STORAGE_BUCKET=kyc-documents
APP_API_TOKEN=[GENERATE_A_LONG_RANDOM_APPLICATION_TOKEN]
ADMIN_ACCESS_TOKEN=[GENERATE_A_DIFFERENT_LONG_RANDOM_ADMIN_TOKEN]
VERCEL_SUPPORT_LARGE_FUNCTIONS=1

# Streamlit Community Cloud secrets (configure separately; do not copy the admin token)
# BACKEND_API_URL=https://[BACKEND_HOST]/api/v1
# APP_API_TOKEN=[SAME_APPLICATION_TOKEN_AS_VERCEL]
# SUPABASE_URL=https://[PROJECT_REF].supabase.co
# SUPABASE_KEY=[PUBLISHABLE_OR_ANON_KEY_ONLY]
